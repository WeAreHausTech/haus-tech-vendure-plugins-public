      "Bash(gh repo view:*)",
      "Bash(gh label list:*)",
      "Bash(gh auth status:*)",
      "Bash(gh search prs:*)",
      "Bash(gh search issues:*)",
      "mcp__ccd_pr__set_auto_merge"
    ],
    "askRules": [
      "Bash(su:*)",
      "Bash(php artisan migrate --force:*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(*.dump)",
      "Read(*.backup)",
      "Read(*.bak)",
      "Read(wp-content/uploads/**)",
      "Read(uploads/**)"
    ]
  },
