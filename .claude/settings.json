{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "haus guard file-access --from-hook"
          }
        ],
        "matcher": "Read|Edit|Write"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "haus guard bash --from-hook"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "haus decisions guard --from-hook"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "haus decisions suggest --from-hook"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "haus update --from-hook"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "haus workspace worktree doctor --from-hook"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "_haus": {
    "hooks": [
      "haus.guard-file",
      "haus.guard-bash",
      "haus.decisions-guard",
      "haus.decisions-suggest",
      "haus.update-check",
      "hook.workspace.worktree-check"
    ],
    "hookCommands": [
      "haus guard file-access --from-hook",
      "haus guard bash --from-hook",
      "haus decisions guard --from-hook",
      "haus decisions suggest --from-hook",
      "haus update --from-hook",
      "haus workspace worktree doctor --from-hook"
    ],
    "denyRules": [
      "Bash(sudo:*)",
      "Bash(chmod -R 777:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(drop database:*)",
      "Bash(truncate table:*)",
      "Bash(npm publish:*)",
      "Bash(yarn npm publish:*)",
      "Bash(pnpm publish:*)",
      "Read(*.pem)",
      "Edit(*.pem)",
      "Write(*.pem)",
      "Read(*.key)",
      "Edit(*.key)",
      "Write(*.key)",
      "Read(*.p12)",
      "Edit(*.p12)",
      "Write(*.p12)",
      "Read(*.pfx)",
      "Edit(*.pfx)",
      "Write(*.pfx)",
      "Read(id_rsa)",
      "Edit(id_rsa)",
      "Write(id_rsa)",
      "Read(id_ed25519)",
      "Edit(id_ed25519)",
      "Write(id_ed25519)",
      "Read(customer-data/**)",
      "Edit(customer-data/**)",
      "Write(customer-data/**)",
      "Read(secrets/**)",
      "Edit(secrets/**)",
      "Write(secrets/**)",
      "Read(certs/**)",
      "Edit(certs/**)",
      "Write(certs/**)"
    ],
    "allowRules": [
      "Bash(haus init:*)",
      "Bash(haus apply:*)",
      "Bash(haus doctor:*)",
      "Bash(haus scan:*)",
      "Bash(haus recommend:*)",
      "Bash(haus explain-recommendation:*)",
      "Bash(haus fetch-refs:*)",
      "Bash(haus rescan:*)",
      "Bash(haus clone:*)",
      "Bash(haus new:*)",
      "Bash(haus update:*)",
      "Bash(haus install:*)",
      "Bash(haus configs:*)",
      "Bash(haus ci-gate:*)",
      "Bash(haus catalog-audit:*)",
      "Bash(haus validate-catalog:*)",
      "Bash(haus backups list:*)",
      "Bash(haus guard file-access:*)",
      "Bash(haus guard bash:*)",
      "Bash(haus catalog bundle export:*)",
      "Bash(haus catalog bundle import:*)",
      "Bash(haus decisions check:*)",
      "Bash(haus decisions suggest:*)",
      "Bash(haus decisions next-number:*)",
      "Bash(haus decisions guard:*)",
      "Bash(haus decisions validate:*)",
      "Bash(haus adr check:*)",
      "Bash(haus adr suggest:*)",
      "Bash(haus adr next-number:*)",
      "Bash(haus adr guard:*)",
      "Bash(haus adr validate:*)",
      "Bash(haus workspace discover:*)",
      "Bash(haus workspace scan:*)",
      "Bash(haus workspace setup:*)",
      "Bash(haus workspace doctor:*)",
      "Bash(haus workspace link-context:*)",
      "Bash(haus workspace worktree add:*)",
      "Bash(haus workspace worktree hydrate:*)",
      "Bash(haus workspace worktree list:*)",
      "Bash(haus workspace worktree doctor:*)"
    ],
    "askRules": [
      "Bash(rm -rf:*)",
      "Bash(chown -R:*)",
      "Bash(git reset --hard:*)",
      "Bash(docker system prune:*)",
      "Bash(php artisan migrate --force:*)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(.env.*)",
      "Write(.env.*)",
      "Edit(storage/logs/**)",
      "Write(storage/logs/**)",
      "Edit(exports/**)",
      "Write(exports/**)",
      "Read(*.dump)",
      "Edit(*.dump)",
      "Write(*.dump)",
      "Read(*.backup)",
      "Edit(*.backup)",
      "Write(*.backup)",
      "Read(*.bak)",
      "Edit(*.bak)",
      "Write(*.bak)",
      "Read(wp-content/uploads/**)",
      "Edit(wp-content/uploads/**)",
      "Write(wp-content/uploads/**)",
      "Read(uploads/**)",
      "Edit(uploads/**)",
      "Write(uploads/**)"
    ]
  },
